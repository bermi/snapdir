      "Bash(touch .gatesmith/:*)",
      "Bash(cp .gatesmith/:*)",
      "Bash(mv .gatesmith/:*)",
      "Bash(rm .gatesmith/evidence/:*)",
      "Bash(rm .gatesmith/handoff/:*)",
      "Bash(date:*)",
      "Bash(echo :*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo insta:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo shear:*)",
      "Bash(cargo semver-checks:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo fuzz:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(rustup target add:*)",
      "Bash(rustup component add:*)",
      "Bash(actionlint:*)",
      "Bash(typos:*)",
