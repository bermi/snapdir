{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git push origin rust-port)",
      "Bash(git push origin rust-port:rust-port)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",

      "Bash(test :*)",
      "Bash(shasum :*)",
      "Bash(b3sum :*)",
      "Bash(diff :*)",
      "Bash(grep :*)",
      "Bash(tail :*)",
      "Bash(head :*)",
      "Bash(cat .gatesmith/:*)",
      "Bash(ls .gatesmith/:*)",
      "Bash(mkdir -p .gatesmith/:*)",
      "Bash(touch .gatesmith/:*)",
      "Bash(cp .gatesmith/:*)",
      "Bash(mv .gatesmith/:*)",
      "Bash(rm .gatesmith/evidence/:*)",
      "Bash(rm .gatesmith/handoff/:*)",
      "Bash(date:*)",
      "Bash(echo :*)",

      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo insta:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo shear:*)",
      "Bash(cargo semver-checks:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo fuzz:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(rustup target add:*)",
      "Bash(rustup component add:*)",
      "Bash(actionlint:*)",
      "Bash(typos:*)",
      "Bash(hyperfine:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",

      "Bash(./snapdir:*)",
      "Bash(./snapdir-manifest:*)",
      "Bash(bash tests/:*)",
      "Bash(bash benches/:*)",

      "Edit(.gatesmith/**)",
      "Write(.gatesmith/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",

      "Edit(snapdir)",
      "Edit(snapdir-manifest)",
      "Edit(snapdir-file-store)",
      "Edit(snapdir-s3-store)",
      "Edit(snapdir-b2-store)",
      "Edit(snapdir-gcs-store)",
      "Edit(snapdir-sqlite3-catalog)",
      "Edit(snapdir-test)",
      "Edit(utils/qa-fixtures/**)"
    ]
  },
  "_note": "PM + teammate allowlist for the snapdir-rs Rust port. Lane fence is enforced at PM tick step 5 (git diff --stat). The Bash oracle scripts and utils/qa-fixtures/ are the FROZEN ORACLE: deny-listed against Edit so no teammate can mutate them. Cargo/rust toolchain commands are allowed so unattended ticks don't stall. Heavy tools (nextest, deny, llvm-cov, fuzz, semver-checks, actionlint, hyperfine, typos) are allow-listed but may need install by the ci lane."
}
